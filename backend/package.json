{
  "name": "skill-management-backend",
  "version": "1.0.0",
  "description": "Backend for Skill Management System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "ts-node src/database/migrate.ts",
    "seed": "ts-node src/database/seed.ts",
    "db:reset": "npm run migrate && npm run seed",
    "seed:master": "ts-node src/database/seed_master_data.ts",
    "migrate:work-exp": "ts-node src/database/migrate_work_experience_data.ts",
    "add:customer-name": "ts-node src/database/add_customer_name.ts",
    "add:industries": "ts-node src/database/add_master_industries.ts",
    "seed:industries": "ts-node src/database/seed_master_industries.ts",
    "migrate:industries": "ts-node src/database/migrate_industry_data.ts",
    "add:remarks": "ts-node src/database/add_remarks_column.ts",
    "add:profile-fields": "ts-node src/database/add_profile_fields.ts",
    "migrate:json-import": "ts-node src/database/runMigration.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@types/multer": "^2.0.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "puppeteer": "^24.29.0",
    "sqlite3": "^5.1.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.24",
    "@types/sqlite3": "^3.1.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
